{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "package.json",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/core/**/*.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["src/main/**/__tests__/**", "src/preload/**/__tests__/**", "src/core/**/__tests__/**"]
}

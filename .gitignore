node_modules/
out/
dist/
release/
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
tests/.boundary-probe/
*.log
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.env
.env.*
!.env.example

# Spike S1 SoundFont fixtures: downloaded by `node spikes/s1/prepare-fixtures.mjs`,
# 32 MB (SF2) and 9 MB (SF3) of binary assets that are not committed.
spikes/s1/fixtures/*.sf2
spikes/s1/fixtures/*.sf3
spikes/s1/results/*.json
spikes/s1/results/*.txt

# The spike's build output: the vendored worklet bundle is produced by
# `pnpm exec vite build --config spikes/s1/worklet/vite.config.ts`.
spikes/s1/renderer/public/vendor/

# Spike S2 build output and measurement reports. The reports are copied into
# `docs/spikes/results/` when they are worth keeping.
spikes/s2/dist/
spikes/s2/results/*.json

# Spike S3 benchmark output. The results are machine-generated by
# `node spikes/s3/tools/bench-mp3.mjs` and the Electron driver; the findings
# are written up in `docs/spikes/s3-mp3-encoder-report.md` and
# `docs/adr/0004-mp3-export.md`.
spikes/s3/results/*.json
spikes/s3/results/*.md

# Spike S4 packaging output. The 64 MiB sample asset, the compiled app and
# the installers are generated by `node spikes/s4/tools/build.mjs` and
# `node spikes/s4/tools/package.mjs`; only the report is committed.
spikes/s4/app/assets/
spikes/s4/app/dist/
spikes/s4/results/

# Local downloads of the CI packaging artefacts, used to collect the size
# and first-launch measurements for the S4 report.
.s4-artifacts/

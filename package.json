{
  "name": "practiceplayer",
  "productName": "PracticePlayer",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop app that plays chord progressions as a practice and improvisation backing track.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:spikes",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:spikes": "tsc --noEmit -p spikes/s1/tsconfig.json && tsc --noEmit -p spikes/s2/tsconfig.json && tsc --noEmit -p spikes/s4/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vite build --ssr tests/fixtures/golden/smoke.mjs --outDir .smoke-out --logLevel warn && node .smoke-out/smoke.js",
    "test:e2e": "pnpm run build && playwright test",
    "audit:deps": "pnpm audit --audit-level high",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "spike:s1:fixtures": "node spikes/s1/prepare-fixtures.mjs",
    "spike:s1:build": "vite build --config spikes/s1/worklet/vite.config.ts && vite build --config spikes/s1/vite.config.ts",
    "spike:s1:node": "node spikes/s1/tools/measure-engine.mjs --seconds 600 --out results",
    "spike:s1:browser": "electron spikes/s1/electron/drive.cjs --soak 600",
    "spike:s2:build": "vite build --config spikes/s2/vite.config.ts",
    "spike:s2:web": "electron spikes/s2/electron/drive.cjs",
    "spike:s2:native": "node spikes/s2/native/measure-native.mjs",
    "spike:s4:build": "node spikes/s4/tools/build.mjs",
    "spike:s4:package": "node spikes/s4/tools/package.mjs",
    "spike:s4:measure": "node spikes/s4/tools/measure.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e && pnpm run audit:deps && pnpm run audit:licenses"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@julusian/midi": "3.8.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "midi-file": "1.2.4",
    "prettier": "3.9.10",
    "spessasynth_core": "4.4.6",
    "spessasynth_lib": "4.4.4",
    "stb-vorbis": "0.0.7",
    "tonal": "6.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/core/**/*.ts",
    "src/audio/**/*.ts",
    "src/midi/**/*.ts"
  ],
  "exclude": ["src/renderer/**/__tests__/**", "src/core/**/__tests__/**"]
}
